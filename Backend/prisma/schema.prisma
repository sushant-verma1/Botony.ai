generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Users table
enum Plan {
  ADVISOR
  PERSONAL
  FRIEND
}

enum Role {
  user
  assistant
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum AttachmentStatus {
  PENDING
  READY
  REJECTED
}

// The origin and verification state are stored separately so the agent never
// treats an inference or an uploaded document as a user-confirmed health fact.
enum MemorySource {
  USER
  DOCUMENT
  CLINICIAN
  AGENT
}

enum MemoryStatus {
  VERIFIED
  PENDING_REVIEW
  REJECTED
}

enum AgentRunStatus {
  STARTED
  SUCCEEDED
  BLOCKED
  CANCELLED
  FAILED
}

enum AgentActionStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  EXECUTED
  REJECTED
  EXPIRED
  FAILED
}

enum MedicationStatus {
  ACTIVE
  ARCHIVED
}

enum MedicationScheduleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DoseStatus {
  SCHEDULED
  TAKEN
  SKIPPED
  MISSED
}

enum ReminderJobStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
  CANCELLED
}

enum NotificationType {
  MEDICATION_REMINDER
  CAREGIVER_MEDICATION_REMINDER
  REFILL_ALERT
}

enum MedicalReportStatus {
  PROCESSING
  READY
  FAILED
}

enum LabObservationFlag {
  NORMAL
  HIGH
  LOW
  UNKNOWN
}

// Measurements are patient-entered records. They deliberately have no
// "normal" or diagnostic state: recording a value must not imply a clinical
// interpretation by the product.
enum HealthMeasurementType {
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  WEIGHT
  HEART_RATE
  TEMPERATURE
  CUSTOM
}

// Each sharing scope is independently granted by the care recipient. New
// scopes are opt-in so adding a feature cannot silently widen an old link.
enum CarePermission {
  VIEW_MEDICATIONS
  VIEW_MEDICATION_SCHEDULES
  VIEW_HEALTH_MEASUREMENTS
  VIEW_APPOINTMENTS
  VIEW_REPORT_SUMMARIES
}

enum CareAccessStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  firstName String?
  lastName  String?
  age       Int

  plan Plan @default(ADVISOR)
  isPremium Boolean @default(false)

  conversations       Conversation[]
  messages            Message[]
  attachments         Attachment[]
  memoryFacts         MemoryFact[]
  agentRuns           AgentRun[]
  agentActions        AgentAction[]
  auditEvents         AuditEvent[]
  medications         Medication[]
  medicationSchedules MedicationSchedule[]
  doseEvents          DoseEvent[]
  reminderJobs        ReminderJob[]
  notifications       AppNotification[]
  pushSubscriptions   PushSubscription[]
  medicalReports      MedicalReport[]
  healthMeasurements  HealthMeasurement[]
  appointments        HealthAppointment[]
  careRecipientLinks  CareAccess[]         @relation("CareRecipient")
  caregiverLinks      CareAccess[]         @relation("Caregiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Conversations table
model Conversation {
  id     String  @id @default(cuid())
  title  String?
  status String  @default("ongoing")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  Message[]
  agentRuns AgentRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Serves listConversationsController: where userId, orderBy updatedAt desc.
  @@index([userId, updatedAt])
}

// Messages table
model Message {
  id                String  @id @default(cuid())
  content           String
  role              Role
  emergencyDetected Boolean @default(false)
  isPremiumKept     Boolean @default(false)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  createdAt DateTime @default(now())

  // Client-supplied key for the first message of a new conversation only.
  // Makes the create-conversation-and-first-message request replay-safe.
  // Always NULL for every other message; never used as a general identifier.
  clientKey String? @unique

  // Serves getHistoryController's cursor pagination and messageController's
  // previousMessages fetch: where conversationId, orderBy createdAt.
  @@index([conversationId, createdAt])
  // Unindexed FK: without this, deleting a User does a full table scan to
  // cascade-delete their messages.
  @@index([userId])
}

// File attachments (medical reports, symptom photos). Only metadata and a
// Cloudinary public_id are stored here — never binary content, never the
// user's original filename.
model Attachment {
  id           String           @id @default(cuid())
  kind         AttachmentKind
  status       AttachmentStatus @default(PENDING)
  mimeType     String
  bytes        Int              @default(0)
  width        Int?
  height       Int?
  publicId     String           @unique
  resourceType String
  folder       String
  // Which scanner cleared this file ("clamav", or "none" when uploads were
  // explicitly allowed unscanned). Kept for audit, not for logic.
  scanner      String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId     String?
  message       Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  medicalReport MedicalReport?

  createdAt DateTime @default(now())

  // Unindexed FK: without this, deleting a User does a full table scan to
  // cascade-delete their attachments. createdAt is the trailing column so the
  // same index also orders a user's attachments without a sort.
  @@index([userId, createdAt])
  // Loading a message's attachments, and the FK cascade when a Message is
  // deleted.
  @@index([messageId])
  // Serves the scheduled cleanup sweep: where status = 'PENDING' and
  // createdAt < cutoff. Without it the sweep scans every attachment ever
  // uploaded to find the handful that were abandoned.
  @@index([status, createdAt])
}

// Small, user-visible facts that can safely be supplied to the health agent.
// This is intentionally not a free-form chat transcript or a diagnosis store.
model MemoryFact {
  id         String       @id @default(cuid())
  category   String
  value      String
  source     MemorySource @default(USER)
  status     MemoryStatus @default(VERIFIED)
  confidence Int          @default(100)
  expiresAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
}

// Lifecycle record for a future tool-using agent run. It contains operational
// metadata only; medical conversation content remains in Message records.
model AgentRun {
  id               String         @id @default(cuid())
  status           AgentRunStatus @default(STARTED)
  intent           String?
  guardrailVersion String
  pendingArguments Json?
  missingFields String[] @default([])
  revision Int @default(1)
  expiresAt DateTime?
  completedAt      DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actions        AgentAction[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

// A side-effect proposal produced by an agent. Its arguments are retained so
// the user confirms the exact action they reviewed, not a regenerated prompt.
model AgentAction {
  id                    String            @id @default(cuid())
  toolName              String
  arguments             Json
  status                AgentActionStatus @default(PENDING_CONFIRMATION)
  confirmationTokenHash String
  revision Int @default(1)
  expiresAt             DateTime
  resultResourceId      String?
  confirmedAt           DateTime?
  executedAt            DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  schedule MedicationSchedule?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
  @@index([agentRunId])
}

// Append-only operational audit trail. `metadata` intentionally excludes
// message text, report contents, prescription instructions, and tokens.
model AuditEvent {
  id           String  @id @default(cuid())
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
}

// Prescription details are entered or imported by the user. The assistant may
// summarize these records, but it cannot create or alter them without the
// application-side confirmation flow added in the agent tool layer.
model Medication {
  id              String           @id @default(cuid())
  name            String
  strength        String?
  form            String?
  instructions    String?
  status          MedicationStatus @default(ACTIVE)
  quantityOnHand  Int?
  refillAt        Int?
  refillAlertedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schedules     MedicationSchedule[]
  doseEvents    DoseEvent[]
  reminderJobs  ReminderJob[]
  notifications AppNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, updatedAt])
}

// Daily local times are stored separately from their materialized UTC jobs.
// This preserves the patient's intended wall-clock reminder across timezones
// and daylight-saving transitions.
model MedicationSchedule {
  id            String                   @id @default(cuid())
  timezone      String
  times         String[]
  startsOn      DateTime
  endsOn        DateTime?
  status        MedicationScheduleStatus @default(ACTIVE)
  agentActionId String?                  @unique

  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  doseEvents   DoseEvent[]
  reminderJobs ReminderJob[]
  agentAction  AgentAction?  @relation(fields: [agentActionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([medicationId, status])
}

// Dose events are the patient record. A reminder job becoming due does not
// mean a dose was taken; that status remains SCHEDULED until the user logs it.
model DoseEvent {
  id           String     @id @default(cuid())
  scheduledFor DateTime
  status       DoseStatus @default(SCHEDULED)
  occurredAt   DateTime?
  note         String?

  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  scheduleId String
  schedule   MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, scheduledFor])
  @@index([userId, status, scheduledFor])
}

// Durable work queue for reminders. A future notification worker atomically
// leases PENDING jobs and records delivery; restarting the API cannot lose a
// planned dose because the work lives in Postgres.
model ReminderJob {
  id           String            @id @default(cuid())
  scheduledFor DateTime
  status       ReminderJobStatus @default(PENDING)
  attempts     Int               @default(0)
  lockedAt     DateTime?
  dispatchedAt DateTime?

  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  scheduleId String
  schedule   MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications AppNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([userId, scheduledFor])
}

// In-app notifications are private to the authenticated patient. Their body
// is never copied into operational logs or sent to a third-party provider.
model AppNotification {
  id     String           @id @default(cuid())
  type   NotificationType
  title  String
  body   String
  readAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  reminderJobId String?
  reminderJob   ReminderJob? @relation(fields: [reminderJobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reminderJobId, userId])
  @@index([userId, readAt, createdAt])
}

// Browser push subscriptions are delivery endpoints, not notification
// history. Notification content and idempotency remain in AppNotification.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  expirationTime DateTime?
  enabled   Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}

// Derived report data is kept separately from the uploaded PDF. Facts remain
// traceable to an attachment and are not treated as a diagnosis or medical
// instruction.
model MedicalReport {
  id            String              @id @default(cuid())
  status        MedicalReportStatus @default(PROCESSING)
  explanation   String?
  questions     Json?
  uncertainties Json?

  attachmentId String     @unique
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  observations LabObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model LabObservation {
  id             String             @id @default(cuid())
  name           String
  value          String
  unit           String?
  referenceRange String?
  flag           LabObservationFlag @default(UNKNOWN)
  sourcePage     Int?

  reportId String
  report   MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
}

// A raw health reading entered by the patient. Blood pressure uses value for
// systolic and secondaryValue for diastolic; values retain their entered unit.
model HealthMeasurement {
  id             String                @id @default(cuid())
  type           HealthMeasurementType
  label          String?
  value          Decimal               @db.Decimal(12, 3)
  secondaryValue Decimal?              @db.Decimal(12, 3)
  unit           String
  measuredAt     DateTime
  note           String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, measuredAt])
}

// An appointment record is owned by the patient. It is not an instruction to
// schedule, change, or cancel real-world medical care.
model HealthAppointment {
  id       String    @id @default(cuid())
  title    String
  startsAt DateTime
  endsAt   DateTime?
  timezone String
  provider String?
  location String?
  note     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startsAt])
}

// A two-party care relationship. Creating an invitation shares no data; it is
// activated only when the invited caregiver explicitly accepts it. Either
// party can end an active link, and only the recipient can create invitations.
model CareAccess {
  id                              String           @id @default(cuid())
  status                          CareAccessStatus @default(PENDING)
  permissions                     CarePermission[]
  medicationReminderNotifications Boolean          @default(false)
  acceptedAt                      DateTime?
  revokedAt                       DateTime?

  recipientId String
  recipient   User   @relation("CareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  caregiverId String
  caregiver   User   @relation("Caregiver", fields: [caregiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipientId, caregiverId])
  @@index([caregiverId, status])
  @@index([recipientId, status])
}
