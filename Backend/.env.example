# Database
DATABASE_URL=

# Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development

# AI providers — Grok is primary, Gemini is the backup used on failover
XAI_API_KEY=
XAI_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cloudinary — used for attachment storage (medical images/reports)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Malware scanning — clamd (ClamAV daemon) reachable over TCP.
# Leave CLAMAV_HOST unset only where unscanned uploads are acceptable:
# ALLOW_UNSCANNED_UPLOADS defaults to false in production, so a production
# deployment without a scanner rejects uploads rather than accepting them.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=20000
ALLOW_UNSCANNED_UPLOADS=false

# Background sweep of abandoned PENDING uploads. Set to 0 to disable the
# in-process timer and run `npm run cleanup:attachments` from a cron instead.
ATTACHMENT_CLEANUP_INTERVAL_MS=900000

# Staging-only, used by `npm run migrate:verify` and `npm run db:explain`.
# Never point these at production. See Docs/migration-verification.md.
STAGING_DATABASE_URL=
STAGING_SHADOW_DATABASE_URL=
EXPLAIN_DATABASE_URL=

# Sentry (optional — app runs fine with this unset)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
