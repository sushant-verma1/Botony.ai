VITE_API_URL=http://localhost:3000/api

# Sentry (optional — app runs fine with this unset).
# Vite inlines this at BUILD time, so it must be set for the production build,
# not just at runtime. Unset, the whole Sentry.init block in src/instrument.ts
# is dead code and Rollup drops it — including the beforeSend/beforeBreadcrumb
# scrubbers, which is correct: nothing is sent, so there is nothing to scrub.
VITE_SENTRY_DSN=
